# Detecta automaticamente arquivos de texto
* text=auto

# Arquivos de código sempre em LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
mvnw text eol=lf

# Scripts Windows sempre em CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf
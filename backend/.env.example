# ============================================================
# Template de variáveis de ambiente do ERP TopPower
# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
#     cp .env.example .env
# O arquivo .env está ignorado pelo git e NÃO deve ser commitado.
# ============================================================

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp-toppower-api
DB_USERNAME=root
DB_PASSWORD=changeme

# JWT (autenticacao)
# Gere um novo secret com: openssl rand -base64 48
JWT_SECRET=changeme-gere-um-secret-seguro-com-openssl-rand-base64-48
JWT_EXPIRATION_HOURS=24

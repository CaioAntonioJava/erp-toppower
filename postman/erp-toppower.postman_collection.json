{
  "info": {
    "name": "ERP TopPower API",
    "description": "Colecao de endpoints da API REST do ERP TopPower. Apos fazer login, o JWT e capturado em {{jwt_token}} e aplicado como Bearer em todos os endpoints protegidos. Documentacao Swagger em /swagger-ui.html.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "erp-toppower-collection-v1"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081", "type": "string"},
    {"key": "jwt_token", "value": "", "type": "string"},
    {"key": "userId", "value": "00000000-0000-0000-0000-000000000000", "type": "string"},
    {"key": "productId", "value": "00000000-0000-0000-0000-000000000000", "type": "string"},
    {"key": "profileId", "value": "00000000-0000-0000-0000-000000000000", "type": "string"},
    {"key": "sellerId", "value": "00000000-0000-0000-0000-000000000000", "type": "string"}
  ],
  "item": [
    {
      "name": "01. Autenticacao",
      "description": "Endpoints públicos e protegidos de autenticação.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"caio@toppower.com.br\",\n  \"password\": \"S3nh@Forte!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Autentica o usuario. Salva o JWT em {{jwt_token}} e userId em {{userId}} automaticamente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"jwt_token\", json.accessToken);",
                  "  pm.collectionVariables.set(\"userId\", json.user.uuid);",
                  "  console.log(\"Token saved (first 20 chars): \" + json.accessToken.substring(0, 20) + \"...\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (dados do usuario autenticado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "me"]
            },
            "description": "Endpoint protegido. Retorna os dados do usuario autenticado a partir do JWT."
          }
        }
      ]
    },
    {
      "name": "02. Usuarios",
      "description": "Cadastro e gestão de usuários.",
      "item": [
        {
          "name": "Cadastrar usuario",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"caio@toppower.com.br\",\n  \"password\": \"S3nh@Forte!\",\n  \"role\": \"ROLE_ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Endpoint publico (sem JWT). Usado para bootstrap do primeiro admin."
          }
        },
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Lista todos os usuários. Apenas ROLE_ADMIN."
          }
        },
        {
          "name": "Buscar usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "Busca usuario por UUID. Apenas ROLE_ADMIN. Use {{userId}} salvo pelo Login."
          }
        },
        {
          "name": "Trocar própria senha",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"S3nh@Forte!\",\n  \"newPassword\": \"N0v@Senh@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "password"]
            },
            "description": "Altera a senha do proprio usuario. UUID do path deve corresponder ao token JWT, senao retorna 403."
          }
        },
        {
          "name": "Resetar senha (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"T3mp@AdminReset!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}", "reset-password"]
            },
            "description": "Redefine a senha de um usuario sem exigir a senha atual. Apenas ROLE_ADMIN."
          }
        }
      ]
    },
    {
      "name": "03. Produtos",
      "description": "Cadastro e gestao de produtos.",
      "item": [
        {
          "name": "Cadastrar produto",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cabo Flexivel 2,5mm\",\n  \"code\": \"CB-FLEX-2.5\",\n  \"unitType\": \"METROS\",\n  \"status\": \"ATIVO\",\n  \"price\": 2.99,\n  \"stockQuantity\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "Cria novo produto. Todas as roles autenticadas. Status default = ATIVO se omitido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"productId\", json.uuid);",
                  "  console.log(\"productId saved: \" + json.uuid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar produtos (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?status=ATIVO&page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                {"key": "status", "value": "ATIVO", "description": "Filtro opcional: ATIVO ou INATIVO", "disabled": false},
                {"key": "page", "value": "0", "description": "Pagina (0-indexed)", "disabled": false},
                {"key": "size", "value": "20", "description": "Tamanho da pagina", "disabled": false},
                {"key": "sort", "value": "name,asc", "description": "Ordenacao: campo,asc|desc", "disabled": false}
              ]
            },
            "description": "Lista produtos paginados. Filtro de status opcional. Todas as roles."
          }
        },
        {
          "name": "Buscar produto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Busca produto por UUID. Use {{productId}} salvo pelo Cadastrar produto."
          }
        },
        {
          "name": "Atualizar produto (parcial)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 3.99,\n  \"stockQuantity\": 250,\n  \"status\": \"ATIVO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Atualiza apenas os campos enviados. Todas as roles autenticadas. Código duplicado -> 409."
          }
        },
        {
          "name": "Inativar produto (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Define status=INATIVO. Todas as roles autenticadas. Resposta 204 No Content."
          }
        },
        {
          "name": "Buscar produtos (ATIVOS e INATIVOS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/search?query=cabo&page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "search"],
              "query": [
                {"key": "query", "value": "cabo", "description": "Termo (mín. 2 caracteres). Match name OU code. Inclui ATIVOS e INATIVOS.", "disabled": false},
                {"key": "page", "value": "0", "disabled": false},
                {"key": "size", "value": "20", "disabled": false},
                {"key": "sort", "value": "name,asc", "disabled": false}
              ]
            },
            "description": "Busca case-insensitive por name OU code, incluindo ATIVOS e INATIVOS. Paginado. Todas as roles."
          }
        }
      ]
    },
    {
      "name": "04. Perfis",
      "description": "Cadastro e gestão de perfis de usuários (relacionamento 1:1 com User). O usuário logado cria o próprio perfil; ADMIN pode ler/alterar qualquer um.",
      "item": [
        {
          "name": "Cadastrar meu perfil",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Caio Antonio da Silva\",\n  \"email\": \"caio@toppower.com.br\",\n  \"phone\": \"(11) 98765-4321\",\n  \"cpf\": \"123.456.789-00\",\n  \"status\": \"ATIVO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profiles"]
            },
            "description": "Cria o perfil do usuario autenticado (1:1 com o User do JWT). O userId NAO vai no body - vem do token. Cada usuario so pode ter 1 perfil (409 se ja existir). Status default = ATIVO se omitido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"profileId\", json.uuid);",
                  "  console.log(\"profileId saved: \" + json.uuid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar perfis (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles?status=ATIVO&page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profiles"],
              "query": [
                {"key": "status", "value": "ATIVO", "description": "Filtro opcional: ATIVO ou INATIVO", "disabled": false},
                {"key": "page", "value": "0", "description": "Pagina (0-indexed)", "disabled": false},
                {"key": "size", "value": "20", "description": "Tamanho da pagina", "disabled": false},
                {"key": "sort", "value": "name,asc", "description": "Ordenacao: campo,asc|desc", "disabled": false}
              ]
            },
            "description": "Lista perfis paginados. Filtro de status opcional. Acesso restrito a ROLE_ADMIN. Retorna 403 para outros usuários."
          }
        },
        {
          "name": "Buscar perfil por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profiles", "{{profileId}}"]
            },
            "description": "Busca perfil por UUID. ADMIN pode ver qualquer; demais usuários só o próprio (caso contrário retorna 403). Use {{profileId}} salvo pelo Cadastrar meu perfil."
          }
        },
        {
          "name": "Buscar perfil por usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profiles", "user", "{{userId}}"]
            },
            "description": "Busca o perfil vinculado a um User específico. ADMIN pode ver qualquer; demais usuários só o próprio (userId do path == UUID do JWT). Retorna 404 se o User não possui perfil."
          }
        },
        {
          "name": "Atualizar perfil (parcial)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Caio Antonio da Silva Junior\",\n  \"phone\": \"(11) 91234-5678\",\n  \"status\": \"ATIVO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profiles", "{{profileId}}"]
            },
            "description": "Atualiza apenas os campos enviados. ADMIN pode alterar qualquer perfil; demais usuários só o próprio (caso contrário 403). O vínculo com User NÃO pode ser alterado. CPF/e-mail duplicado -> 409."
          }
        },
        {
          "name": "Inativar perfil (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "profiles", "{{profileId}}"]
            },
            "description": "Define status=INATIVO. Acesso restrito a ROLE_ADMIN. Resposta 204 No Content."
          }
        }
      ]
    },
    {
      "name": "05. Vendedores",
      "description": "Cadastro e gestão de vendedores com percentual de comissão. POST, PATCH e GET (listar): todas as roles. GET (por ID), inativar e reativar: apenas ADMIN.",
      "item": [
        {
          "name": "Cadastrar vendedor",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João da Silva\",\n  \"email\": \"joao@toppower.com.br\",\n  \"phone\": \"(11) 98765-4321\",\n  \"cpf\": \"111.222.333-96\",\n  \"commissionRate\": 5.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sellers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sellers"]
            },
            "description": "Cria um novo vendedor. commissionRate em % (ex: 5.50 = 5,50%) e OPCIONAL: aceita null ou 0.00 (vendedor sem comissao). Quando informado, deve estar entre 0,00% e 100,00%. Status default = ATIVO se omitido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"sellerId\", json.uuid);",
                  "  console.log(\"sellerId saved: \" + json.uuid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar vendedores (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sellers?page=0&size=20&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sellers"],
              "query": [
                {"key": "page", "value": "0", "description": "Pagina (0-indexed)", "disabled": false},
                {"key": "size", "value": "20", "description": "Tamanho da pagina", "disabled": false},
                {"key": "sort", "value": "name,asc", "description": "Ordenacao: campo,asc|desc", "disabled": false}
              ]
            },
            "description": "Lista vendedores paginados, ordenados por nome. Todas as roles autenticadas."
          }
        },
        {
          "name": "Buscar vendedor por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sellers/{{sellerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sellers", "{{sellerId}}"]
            },
            "description": "Busca vendedor por UUID. Acesso restrito a ROLE_ADMIN. Use {{sellerId}} salvo pelo Cadastrar vendedor."
          }
        },
        {
          "name": "Atualizar vendedor (parcial)",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commissionRate\": 7.25,\n  \"phone\": \"(11) 91234-5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sellers/{{sellerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sellers", "{{sellerId}}"]
            },
            "description": "Atualiza apenas os campos enviados. commissionRate aceita 0.00 (vendedor sem comissao) e ate 100%. status aceita ATIVO/INATIVO. CPF/e-mail duplicado -> 409."
          }
        },
        {
          "name": "Inativar vendedor (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sellers/{{sellerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sellers", "{{sellerId}}"]
            },
            "description": "Define status como INATIVO. NAO remove o registro. Acesso restrito a ROLE_ADMIN. Resposta 204 No Content."
          }
        },
        {
          "name": "Reativar vendedor",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sellers/{{sellerId}}/activate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sellers", "{{sellerId}}", "activate"]
            },
            "description": "Define status como ATIVO, reativando um vendedor inativo. Acesso restrito a ROLE_ADMIN."
          }
        }
      ]
    }
  ]
}

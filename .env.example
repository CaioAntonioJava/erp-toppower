# ============================================================
# Variáveis de ambiente — ERP TopPower (Docker)
# Copie este arquivo para ".env" na raiz do projeto e ajuste:
#     cp .env.example .env
# ATENÇÃO: o .env está ignorado no git e NÃO deve ser commitado.
# ============================================================

# Banco de dados MySQL (usado pelo serviço "db" e pelo "backend")
DB_NAME=erp-toppower-api
DB_PASSWORD=troque-por-uma-senha-forte

# JWT (autenticação)
# Gere um secret seguro com (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Ou no Linux/Git Bash:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-secret-seguro-de-48-bytes-ou-mais
JWT_EXPIRATION_HOURS=24